# ─────────────────────────────────────────────────────────────────────────────
# ExecSignal environment variables.
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# The app runs fully against mock/fixture implementations with these left blank.
# ─────────────────────────────────────────────────────────────────────────────

# --- Data layer selection -----------------------------------------------------
# "fixture" (default, no network/db) or "supabase" (requires the keys below).
DATA_BACKEND=fixture

# --- LLM client selection ------------------------------------------------------
# "mock" (default, deterministic, no network) or "anthropic" (requires key).
LLM_BACKEND=mock

# --- Auth selection ------------------------------------------------------------
# "mock" (default, cookie-based test user, no network) or "supabase" (requires keys).
AUTH_BACKEND=mock

# --- Supabase (deferred until a hosted project exists; see DEPLOY.md) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (the app's own analysis engine) --------------------------------
ANTHROPIC_API_KEY=

# --- Logging -------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug

# --- Deferred / future integrations -------------------------------------------
# X (Twitter) API — auto-posting stays disabled in MVP.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Market data provider (quotes / charts).
MARKET_DATA_API_KEY=
